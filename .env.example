# Will fill out with variables as they arise
# Variables prefixed with "VITE_" are public and can be viewed by the user

# Backend API URL
# Only optional if not interacting with backend
VITE_API_URL=

# Supabase project URL and public (publishable or legacy anon) key.
# Never put a Supabase secret/service_role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
